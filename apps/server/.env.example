# ------------------------------------------------------------------
# ClassSync server configuration
# Copy this file to `.env` and adjust. Every value is validated by Zod
# (apps/server/src/config/env.ts) at startup - the server refuses to
# boot on invalid configuration.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# MongoDB (used from Phase 2 onwards)
MONGODB_URI=mongodb+srv://kvashu9060_db_user:7QK4PhUcNmuoMLKz@cluster0.0mksogn.mongodb.net/?appName=Cluster0&compressors=zlib

# Auth - MUST be replaced with a unique value in production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# LLM pipeline. `stub` runs the entire pipeline offline (deterministic, no key).
# `gemini` uses the official @google/genai SDK via Google AI Studio.
# NEVER commit a real key here - keep it in your untracked .env only.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Default user timezone (IANA name) - relative dates resolve against this
TZ_DEFAULT=Asia/Kolkata

# Observability: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_MAX=60

# Background worker that runs the processing pipeline on ingested messages
WORKER_ENABLED=true
WORKER_INTERVAL_MS=4000
