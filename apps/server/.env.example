# ------------------------------------------------------------------
# ClassSync server configuration
# Copy this file to `.env` and adjust. Every value is validated by Zod
# (apps/server/src/config/env.ts) at startup - the server refuses to
# boot on invalid configuration.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# MongoDB (used from Phase 2 onwards)
MONGODB_URI=mongodb://127.0.0.1:27017/classsync

# Auth - MUST be replaced with a unique value in production
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# LLM pipeline (Phase 6). `stub` runs the pipeline without an API key.
# `gemini` uses the official @google/genai SDK (e.g. model `gemini-1.5-flash`,
# free tier via Google AI Studio).
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

# Default user timezone (IANA name) - relative dates resolve against this
TZ_DEFAULT=Asia/Kolkata
